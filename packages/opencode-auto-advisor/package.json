{
  "name": "@capybearista/opencode-auto-advisor",
  "version": "2.0.0",
  "description": "A Claude Code-style Advisor for OpenCode: a stronger model reviews the agent's work on request or automatically at decision points.",
  "type": "module",
  "license": "MPL-2.0",
  "author": "capyBearista <capybearista@github.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/capyBearista/opencode-plugins.git",
    "directory": "packages/opencode-auto-advisor"
  },
  "exports": {
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "default": "./dist/tui.js"
    }
  },
  "files": [
    "dist",
    "server.js",
    "tui.js"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc --emitDeclarationOnly && bun build src/server.ts src/tui.ts --outdir=dist --target=bun --external '@opencode/*' --external '@opentui/*' --external 'solid-js'",
    "typecheck": "tsc --noEmit",
    "lint": "bunx @biomejs/biome check .",
    "check": "bunx @biomejs/biome check --write .",
    "ci": "bunx @biomejs/biome ci .",
    "test": "bun test",
    "smoke": "bun run build && bun scripts/smoke-built.ts",
    "timeline": "bun scripts/timeline.ts"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.2.0 <3",
    "@opentui/core": ">=0.6.6",
    "@opentui/solid": ">=0.6.6",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/plugin": "2.2.0",
    "@opentui/core": "0.7.0",
    "@opentui/solid": "0.7.0",
    "@types/bun": "latest",
    "@types/node": "^26.6.5",
    "solid-js": "1.9.17",
    "typescript": "^7.0.2"
  }
}
