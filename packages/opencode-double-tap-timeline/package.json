{
  "name": "@capybearista/opencode-double-tap-timeline",
  "version": "2.0.1",
  "description": "Double-tap Escape key to open the timeline modal, inspired by Claude Code's /rewind feature",
  "author": "capyBearista <capybearista@github.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/capyBearista/opencode-plugins.git",
    "directory": "packages/opencode-double-tap-timeline"
  },
  "type": "module",
  "license": "MPL-2.0",
  "exports": {
    "./tui": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "tui.js"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc --emitDeclarationOnly && bun build src/index.ts --outdir=dist --target=bun --external '@opencode/*' --external '@opentui/*' --external 'solid-js' --external 'tree-sitter*'",
    "typecheck": "tsc --noEmit",
    "lint": "bunx @biomejs/biome check .",
    "check": "bunx @biomejs/biome check --write .",
    "ci": "bunx @biomejs/biome ci .",
    "test": "bun test"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.0 <3",
    "@opentui/core": ">=0.5.10",
    "@opentui/solid": ">=0.5.10",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/plugin": "2.2.0",
    "@opentui/solid": "0.7.0",
    "@opentui/core": "0.7.0",
    "solid-js": "1.9.17"
  }
}
