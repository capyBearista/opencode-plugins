{
  "name": "@capybearista/opencode-adversarial-review",
  "version": "0.1.0",
  "description": "Adversarial code review plugin",
  "author": "capyBearista <capybearista@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/capyBearista/opencode-plugins.git",
    "directory": "packages/opencode-adversarial-review"
  },
  "type": "module",
  "license": "MPL-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "check": "bunx @biomejs/biome check --write .",
    "lint": "bunx @biomejs/biome check .",
    "ci": "bunx @biomejs/biome ci .",
    "test": "bun test"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.14.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": ">=1.14.0",
    "@tsconfig/node22": "^22.0.0",
    "@types/bun": "latest",
    "typescript": "^6.0.3"
  }
}
