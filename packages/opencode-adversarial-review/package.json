{
  "name": "@capybearista/opencode-adversarial-review",
  "version": "1.0.0",
  "description": "Two code review agents for OpenCode — an adversarial reviewer (/adversarial-review) that challenges the implementation, and a constructive reviewer (/review) focused on correctness and suggestions",
  "author": "capyBearista <capybearista@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/capyBearista/opencode-plugins.git",
    "directory": "packages/opencode-adversarial-review"
  },
  "type": "module",
  "license": "MPL-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "commands",
    "dist",
    "server.js"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "typecheck": "tsc --noEmit",
    "check": "bunx @biomejs/biome check --write .",
    "lint": "bunx @biomejs/biome check .",
    "ci": "bunx @biomejs/biome ci .",
    "test": "bun test",
    "smoke": "bun run build && bun scripts/smoke-built.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "@opencode/plugin": "2.0.2"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.2",
    "@tsconfig/node22": "^22.0.0",
    "@types/bun": "latest",
    "typescript": "^6.0.3"
  }
}
