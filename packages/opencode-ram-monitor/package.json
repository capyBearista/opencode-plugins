{
  "name": "@capybearista/opencode-ram-monitor",
  "version": "2.0.0",
  "description": "Monitor OpenCode's RAM usage in real-time, right from your sidebar.",
  "author": "capyBearista <capybearista@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/capyBearista/opencode-plugins.git",
    "directory": "packages/opencode-ram-monitor"
  },
  "license": "MPL-2.0",
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "files": [
    "dist",
    "server.js",
    "tui.js"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc --project tsconfig.build.json --emitDeclarationOnly && bun build src/server.ts --outfile=dist/server.js --target=bun --external '@opencode/*' && bun build src/tui.ts --outfile=dist/tui.js --target=bun --external '@opencode/*' --external '@opentui/*' --external 'solid-js' --external 'tree-sitter*'",
    "typecheck": "tsc --noEmit",
    "check": "bunx @biomejs/biome check --write .",
    "lint": "bunx @biomejs/biome check .",
    "ci": "bunx @biomejs/biome ci .",
    "test": "bun test",
    "smoke": "bun run build && bun scripts/smoke-built.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "default": "./dist/tui.js"
    }
  },
  "peerDependencies": {
    "@opencode/plugin": "2.0.2",
    "@opentui/core": ">=0.5.10",
    "@opentui/solid": ">=0.5.10",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.2",
    "@opentui/core": "0.5.10",
    "@opentui/solid": "0.5.10",
    "@types/bun": "latest",
    "@types/node": "^25.8.0",
    "solid-js": "1.9.12",
    "typescript": "^5.8.0"
  }
}
