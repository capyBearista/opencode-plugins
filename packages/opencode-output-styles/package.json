{
  "name": "@capybearista/opencode-output-styles",
  "version": "1.0.0",
  "description": "Output styles plugin for OpenCode",
  "author": "capyBearista <capybearista@github.com>",
  "type": "module",
  "license": "MPL-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "built-in-styles"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "typecheck": "tsc --noEmit",
    "lint": "bunx @biomejs/biome check .",
    "check": "bunx @biomejs/biome check --write .",
    "ci": "bunx @biomejs/biome ci .",
    "test": "bun test"
  },
  "dependencies": {
    "yaml": "^2.4.5"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.14.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": ">=1.14.0"
  }
}
