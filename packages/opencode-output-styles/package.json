{
  "name": "@capybearista/opencode-output-styles",
  "version": "1.0.1",
  "description": "Persistent response style guidelines for OpenCode sessions — explanatory, learning, and custom modes that survive restarts",
  "author": "capyBearista <capybearista@github.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/capyBearista/opencode-plugins.git",
    "directory": "packages/opencode-output-styles"
  },
  "type": "module",
  "license": "MPL-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "built-in-styles"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "typecheck": "tsc --noEmit",
    "lint": "bunx @biomejs/biome check .",
    "check": "bunx @biomejs/biome check --write .",
    "ci": "bunx @biomejs/biome ci .",
    "test": "bun test"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.15.3"
  },
  "devDependencies": {
    "@opencode-ai/plugin": ">=1.15.3"
  }
}
