{
  "name": "opencode-plugins",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.12",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test:release": "bun test tools/release-channel-guard.test.ts",
    "test": "bun run test:release && turbo run test",
    "lint:release": "bunx @biomejs/biome check tools/release-channel-guard.ts tools/release-channel-guard.test.ts tools/release-channels.json tools/tsconfig.release.json",
    "lint": "bun run lint:release && turbo run lint",
    "typecheck:release": "tsc --project tools/tsconfig.release.json --noEmit",
    "typecheck": "bun run typecheck:release && turbo run typecheck",
    "check": "turbo run check",
    "changeset": "changeset",
    "release:check": "bun tools/release-channel-guard.ts --check",
    "release:changesets": "bun tools/release-channel-guard.ts --changesets",
    "changeset:publish": "turbo run build && bun tools/release-channel-guard.ts --publish",
    "release:publish": "bun run changeset:publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.6.5",
    "husky": "^9.1.7",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2"
  }
}
